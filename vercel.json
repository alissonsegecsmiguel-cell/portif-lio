{
  "redirects": [
    {
      "source": "/",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/portifolio",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/portifolio/:path*",
      "destination": "/portfolio/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/portfolio/assets/:path*"
    },
    {
      "source": "/referenciais/:path*",
      "destination": "/portfolio/referenciais/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "/portfolio/favicon.svg"
    },
    {
      "source": "/dashboard/casal/:path*",
      "destination": "/dashboards/casal/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portfolio/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/caderninho-marcia/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

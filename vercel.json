{
  "redirects": [
    { "source": "/", "destination": "/portfolio", "permanent": false },
    { "source": "/portifolio", "destination": "/portfolio", "permanent": true },
    { "source": "/portifolio/:path*", "destination": "/portfolio/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/portfolio/assets/:path*" },
    { "source": "/referenciais/:path*", "destination": "/portfolio/referenciais/:path*" },
    { "source": "/favicon.svg", "destination": "/portfolio/favicon.svg" }
  ]
}
